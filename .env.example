# Algovested admin console. Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Bypasses row-level security: keep it out of git and out of the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Supabase personal access token for the cron/SQL views.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Comma-separated verified emails that always have admin access (in addition to role = admin).
ADMIN_EMAILS=you@example.com
